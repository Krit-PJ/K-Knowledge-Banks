{
  "name": "kekb",
  "version": "0.1.0",
  "private": true,
  "description": "K-Knowledge Bank \u2014 deterministic validator, workflow engine and Apps Script backend",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate": "node validator/bin/kekb-validate.js",
    "test": "node --test \"validator/test/*.test.js\" \"core/test/*.test.js\" \"backend/apps-script/test/*.test.js\" \"tests/frontend/*.test.js\"",
    "test:slice": "node --test core/test/slice.test.js",
    "kekb": "node core/bin/kekb.js",
    "test:golden": "node --test validator/test/golden.test.js",
    "build:apps-script": "node scripts/build-apps-script.mjs",
    "build:templates": "node scripts/build-templates.mjs",
    "build": "node scripts/build-templates.mjs && node scripts/build-apps-script.mjs"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.2"
  }
}
